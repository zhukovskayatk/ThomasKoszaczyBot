# Скопируйте этот файл в ".env" и подставьте свой токен,
# полученный у @BotFather в Telegram.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Необязательно: ключ DeepSeek API (platform.deepseek.com/api_keys) —
# включает распознавание даты/приоритета из свободного текста задачи.
# Без него бот просто не пытается это делать.
DEEPSEEK_API_KEY=sk-ExampleKeyReplaceMe

# Необязательно: ключ OpenAI API (platform.openai.com/api-keys) —
# включает распознавание речи в голосовых сообщениях (Whisper). Без него
# бот отвечает "не получилось распознать" и просит написать текстом.
OPENAI_API_KEY=sk-ExampleKeyReplaceMe

# Необязательно, но нужно для команд /grant_premium и /revoke_premium
# (выдать/снять Premium вручную, см. handlers/admin.py) — это ТВОЙ
# Telegram user_id (число, не username). Узнать его: написать /start
# боту @userinfobot в Telegram, он пришлёт id в ответ. Без этого поля
# обе команды не сработают вообще ни для кого — это правильный и
# безопасный вариант по умолчанию, пока ты сама не впишешь сюда свой id.
OWNER_USER_ID=123456789
