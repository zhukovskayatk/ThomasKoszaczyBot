# Скопируйте этот файл в ".env" и подставьте свой токен,
# полученный у @BotFather в Telegram.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Необязательно: ключ DeepSeek API (platform.deepseek.com/api_keys) —
# включает распознавание даты/приоритета из свободного текста задачи.
# Без него бот просто не пытается это делать.
DEEPSEEK_API_KEY=sk-ExampleKeyReplaceMe
